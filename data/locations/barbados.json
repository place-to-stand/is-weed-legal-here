  "administrativeAreaLevel1": [
    {
      "name": "Saint Michael",
      "isWeedLegalHere": {
        "overview": [
          {
            "_key": "fc6c15aad02e",
            "_type": "block",
            "children": [
              {
                "_key": "1bb9847e679d0",
                "_type": "span",
                "marks": [],
                "text": "In Saint Michael, Barbados, the vibe around cannabis is pretty laid-back but with clear lines drawn. Recreational use is a no-go, but the island's cool with medical cannabis and lets registered Rastafarians use it for their spiritual rituals. The Medicinal Cannabis Industry Act of 2019 kicked off a system for growing and selling medical weed. And for those practicing Rastafari, the Sacramental Cannabis Act has got their back. Got caught with up to 14 grams just for yourself? No sweat, you'll just pay a $200 fine instead of facing harsher penalties."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "12cf632423ca",
            "_type": "block",
            "children": [
              {
                "_key": "de269150c1cf0",
                "_type": "span",
                "marks": [],
                "text": "Diving into the specifics, like Delta-8, Delta-9 THC, THCA, and CBD, in Saint Michael, things get a bit more technical. The law separates the more chill, non-psychoactive stuff, labeled as \"hemp,\" from the more intense psychoactive cannabis, reserved for medical peeps. Recent updates are all about tightening up the medical and therapeutic use of cannabis, making sure everything from research to selling is up to snuff. Even with the buzz around CBD's benefits, the market's still like the wild west, trying to fit into Barbados' evolving cannabis rules."
              }
            ],
            "markDefs": [],
            "style": "normal"
          }
        ],
